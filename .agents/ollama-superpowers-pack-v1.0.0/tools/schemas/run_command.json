{
  "type": "function",
  "function": {
    "name": "run_command",
    "description": "Run an allowlisted command without a shell",
    "parameters": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "cwd": {
          "type": "string",
          "default": "."
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      },
      "required": [
        "argv"
      ]
    }
  }
}
