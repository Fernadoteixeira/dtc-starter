OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=

OLLAMA_LOCAL_MODEL=gpt-oss:20b
OLLAMA_CLOUD_MODEL=glm-5.2:cloud
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_VISION_MODEL=gemma4

OLLAMA_SUPERPOWERS_WRITE_ENABLED=false
OLLAMA_SUPERPOWERS_SHELL_ENABLED=true
OLLAMA_SUPERPOWERS_ALLOW_CLOUD_WITH_SECRETS=false
OLLAMA_SUPERPOWERS_MAX_TOOL_STEPS=12
OLLAMA_SUPERPOWERS_AUDIT_DIR=.audit
