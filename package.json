{
  "name": "dtc-starter-monorepo",
  "private": false,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "reconcile:ssot": "node scripts/reconcile-blueprint-ssot.mjs"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "typescript": "^5.6.2",
      "@babel/core@<7.29.6": "7.29.7",
      "@opentelemetry/core@<2.8.0": "2.10.0",
      "@protobufjs/utf8@<=1.1.0": "1.1.2",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=8.0.0 <8.18.0": "8.18.0",
      "axios": "1.19.0",
      "body-parser": "1.20.6",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "diff": "4.0.4",
      "fast-uri": "3.1.5",
      "flatted": "3.4.4",
      "follow-redirects": "1.16.0",
      "form-data": "4.0.6",
      "immutable": "3.8.3",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "lodash": "4.18.1",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "path-to-regexp@<0.1.13": "0.1.13",
      "postcss@<8.5.26": "8.5.26",
      "protobufjs": "7.6.5",
      "qs": "6.15.3",
      "rollup": "4.59.0"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@medusajs/eslint-plugin": "2.18.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "2.10.9-canary.1",
    "typescript": "^5.6.2"
  }
}
